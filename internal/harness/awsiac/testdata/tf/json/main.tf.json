{
  "variable": {
    "stage": {"default": "ci"}
  },
  "locals": {
    "name": "jobs-${var.stage}"
  },
  "resource": {
    "aws_sqs_queue": {
      "jobs": {
        "name": "${local.name}",
        "message_retention_seconds": 3600,
        "tags": {"stage": "${var.stage}"}
      }
    },
    "aws_dynamodb_table": {
      "state": {
        "name": "state-${var.stage}",
        "hash_key": "LockID",
        "billing_mode": "PAY_PER_REQUEST",
        "attribute": [{"name": "LockID", "type": "S"}]
      }
    }
  },
  "output": {
    "jobs_arn": {"value": "${aws_sqs_queue.jobs.arn}"}
  }
}
